{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "welcome.schema.json",
  "x-message": { "type": "welcome", "direction": "server" },
  "title": "Welcome",
  "description": "Sent once after a valid hello. Tells the client its own player id.",
  "type": "object",
  "required": ["playerId"],
  "additionalProperties": false,
  "properties": {
    "playerId": {
      "$ref": "common.schema.json#/$defs/playerId"
    }
  }
}
