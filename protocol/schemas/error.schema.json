{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "x-message": { "type": "error", "direction": "server" },
  "title": "Error",
  "description": "Something the client sent was refused. Clients act on code; message is for humans and logs.",
  "type": "object",
  "required": ["code", "message"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "description": "Machine-readable reason.",
      "type": "string",
      "enum": [
        "unsupported_protocol_version",
        "invalid_message",
        "invalid_tile",
        "rate_limited"
      ]
    },
    "message": {
      "description": "Short explanation in English, for humans and logs.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ref_seq": {
      "description": "seq of the client message that caused the error, when there is one.",
      "$ref": "common.schema.json#/$defs/seq"
    }
  }
}
